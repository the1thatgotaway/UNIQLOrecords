# Commit this example with empty values and placeholders only.
# Local setup: copy this file to .env in the repository root.
# Hosted setup: enter real values in the host's server-side environment
# settings (Render: service > Environment, AI Studio: Secrets).
#
# Agents: ask the project owner to create credentials in the provider dashboard
# and enter them directly in their local .env or the hosting secret settings.
# Keep credentials out of chat, Git, logs, screenshots, and browser code.
# Never put a secret in a VITE_ variable, which can be exposed to the browser.
# Revoke and replace any credential that has been exposed.

# Local HTTP port. On a managed host such as Render, use the host-provided PORT.
PORT=3000

# Groq powers chat and briefings. Create a project key at https://console.groq.com/keys.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Supabase project URL and publishable key from Project Settings > API Keys.
# The dashboard can read rows visible under the configured Supabase policies.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
